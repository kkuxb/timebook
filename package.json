{
  "name": "timebook",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "corepack pnpm -r --workspace-concurrency=1 build",
    "desktop:dev": "corepack pnpm --filter @timebook/desktop dev",
    "desktop:build": "corepack pnpm --filter @timebook/desktop tauri:build",
    "desktop:test": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "dev:api": "corepack pnpm --filter @timebook/api dev",
    "dev:web": "corepack pnpm --filter @timebook/web dev",
    "test": "vitest run",
    "typecheck": "corepack pnpm -r typecheck"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.0.0"
}
