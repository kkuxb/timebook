# 服务监听端口
PORT=3210

# SQLite 与自动备份目录（容器内建议固定为 /data）
DATA_DIR=./workspace-data/dev-db

# 访问口令（请替换为个人强口令）
TIMEBOOK_PASSWORD=change-me-please

# Cookie HMAC 签名密钥（请替换为随机长字符串）
TIMEBOOK_SECRET=change-me-random-secret

# Cookie Secure 策略：auto（按 HTTPS 或 X-Forwarded-Proto 自动判断）| true | false
COOKIE_SECURE=auto
